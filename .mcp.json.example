{
  "mcpServers": {
    "line-harness": {
      "command": "npx",
      "args": [
        "-y",
        "@line-harness/mcp-server@latest"
      ],
      "env": {
        "LINE_HARNESS_API_URL": "https://<あなたの Worker>.workers.dev",
        "LINE_HARNESS_API_KEY": "<セットアップ完了画面に出る API Key>",
        "LINE_HARNESS_ACCOUNT_ID": "<管理画面のアカウント ID>"
      }
    }
  }
}
